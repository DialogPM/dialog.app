<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Xcode signs App Store / TestFlight exports with
	     "production" automatically; development builds use the APNs sandbox. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
